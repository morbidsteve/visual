apiVersion: v1
kind: Secret
metadata:
  name: network-visualizer-secrets
  namespace: network-visualizer
type: Opaque
stringData:
  # Elasticsearch credentials
  ES_NODE: "https://elasticsearch.example.com:9200"
  ES_USERNAME: "elastic"
  ES_PASSWORD: "changeme"

---
# To create this secret from command line:
# kubectl create secret generic network-visualizer-secrets \
#   --from-literal=ES_NODE=https://elasticsearch:9200 \
#   --from-literal=ES_USERNAME=elastic \
#   --from-literal=ES_PASSWORD=changeme \
#   -n network-visualizer
